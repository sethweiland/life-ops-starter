# Life-ops tenant load order (see docs/life-ops.md):
# 1. TENANT_CONFIG if set
# 2. S3 ops/tenant.yaml when OPS_BUCKET (or MEME_ASSETS_BUCKET) is set
# 3. config/tenant.yaml if present (gitignored)
# 4. config/tenant.example.yaml
# Friend setup: copy config/tenant.example.yaml → config/tenant.yaml
# Guided setup: docs/onboarding/start-here.md
# Secret choices and support limits: docs/onboarding/secrets.md
# TENANT_CONFIG=config/tenant.yaml

# Hosted login is required by wsgi.py. Local demo: python web/run.py --local
# Generate these with scripts/setup_auth.py; never invent or reuse an access key.
# Import the generated server.env into your runtime environment. See:
# docs/onboarding/authentication.md
# LIFE_OPS_ORIGIN=https://ops.example.com
# LIFE_OPS_OWNER_KEY_SHA256=
# LIFE_OPS_SESSION_SECRET=
# LIFE_OPS_PROXY_HOPS=0  # 1 only behind one trusted TLS-terminating proxy

# Optional S3 for private ops/ data (tenant, board, spend, calendar, queues).
# Without a bucket, local files under data/ are used.
# OPS_BUCKET=
# MEME_ASSETS_BUCKET=  # compatibility alias; OPS_BUCKET takes precedence
# AWS_DEFAULT_REGION=us-east-1
# Prefer your runtime's profile/role when available. Web-console login is separate.
# AWS_PROFILE=life-ops
# If using environment credentials instead of a profile/role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # required with temporary environment credentials

# Optional secret ICS URL for the calendar module. Never put this in tenant.yaml.
# If unset, Home reads ops/calendar/snapshot.json (local: data/calendar/snapshot.json).
# CALENDAR_ICS_URL=

# Optional Home weather: enable modules.weather in private tenant configuration.
# Choose approximate city-center coordinates, not an address or live GPS position.
# Requests send coordinates rounded to 2 decimals to Open-Meteo. Personal use only;
# review provider terms and docs/onboarding/weather.md before enabling.
# LIFE_OPS_WEATHER_LATITUDE=
# LIFE_OPS_WEATHER_LONGITUDE=
# LIFE_OPS_WEATHER_LABEL=Your area
# LIFE_OPS_WEATHER_UNITS=fahrenheit  # fahrenheit or celsius

# Spend project tag on token events (default: tenant defaults.usage_project).
# USAGE_PROJECT=home-ops

# Optional Spend connections. These do not connect model accounts automatically.
# LIFE_OPS_USAGE_PROVIDERS=xai  # comma-separated producer IDs; empty disables logs
# LIFE_OPS_AWS_COSTS=false     # explicit opt-in; Cost Explorer reads can incur charges
# LIFE_OPS_LEGACY_XAI_PROJECT= # only for migration of old untagged records
# See docs/onboarding/spend.md for permissions, verification, cost basis and fallback.

# Optional AWS Secrets Manager JSON for helper-managed settings, then env fallback.
# This does not populate all env vars. CALENDAR_ICS_URL is env-only today.
# Keep secrets.backend: env; the aws/bitwarden backend selectors are not implemented.
# Establish an AWS identity before reading a secret; restart after secret rotation.
# APP_SECRET_ARN=
# AWS_REGION=us-east-1
